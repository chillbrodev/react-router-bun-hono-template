{
  "name": "react-router-bun-hono-template",
  "version": "v0.0.1",
  "private": true,
  "sideEffects": true,
  "type": "module",
  "description": "A React Router v8 template using Bun, Hono and Vitest, with a PokéAPI-powered Pokédex demo.",
  "author": "José Pereira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chillbrodev/react-router-bun-hono-template.git"
  },
  "homepage": "https://github.com/chillbrodev/react-router-bun-hono-template#readme",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "bunx --bun react-router build",
    "dev": "bunx --bun vite",
    "start": "NODE_ENV=production bun ./build/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc --noEmit",
    "check": "biome check --write ."
  },
  "dependencies": {
    "hono": "^4.13.13",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "react-router-hono-server": "^4.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
